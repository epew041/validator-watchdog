# Copy to .env for local runs. PLACEHOLDERS ONLY — never commit a real key.
# The server reads these from the environment; Railway variables work the same way.

# Port to listen on (Railway sets PORT automatically).
PORT=3000

# Comma-separated list of public JSON-RPC endpoints to watch.
# Defaults: BSC dataseed, eth.llamarpc.com, polygon-rpc.com.
# WATCHDOG_TARGETS=https://bsc-dataseed.binance.org/,https://eth.llamarpc.com,https://polygon-rpc.com

# Check interval in milliseconds (default 60000, minimum 5000).
# WATCHDOG_INTERVAL_MS=60000

# Delay between targets inside one cycle (default 1000). Keeps checks gentle.
# WATCHDOG_TARGET_DELAY_MS=1000

# Per-request timeout in milliseconds (default 10000).
# WATCHDOG_REQUEST_TIMEOUT_MS=10000

# Status thresholds (see README for what each one means).
# WATCHDOG_SLOW_MS=2000
# WATCHDOG_DOWN_FAILURES=2
# WATCHDOG_STALL_CHECKS=3
# WATCHDOG_BACKOFF_MS=60000

# Directory for the append-only report log (default: data).
# WATCHDOG_DATA_DIR=data

# Optional stable signing identity: a PKCS#8 PEM Ed25519 private key.
# Generate one with: openssl genpkey -algorithm Ed25519
# If absent, a fresh keypair is generated at every boot (ephemeral identity).
# NEVER paste a real key into this file. Set it only in the hosting dashboard.
# WATCHDOG_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
